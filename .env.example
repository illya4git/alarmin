# Copy to .env (git-ignored). Used by `pnpm --filter @alarmin/proxy dev` and docker-compose.yml.

# Comma-separated app keys the watch may send in X-Alarmin-Key (min 16 chars each).
# Generate one: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
APP_KEYS=

# Watch build (scripts/watch.ts): Connect IQ developer key and the proxy URL baked into the app.
# The simulator can use plain HTTP; a real watch needs HTTPS with a valid certificate.
WATCH_DEVELOPER_KEY=
WATCH_PROXY_URL=http://127.0.0.1:8080

# Optional overrides (defaults shown)
# PORT=8080
# LOG_LEVEL=info
# SIREN_BASE_URL=https://siren.pp.ua
# POLL_INTERVAL_MS=5000
# UPSTREAM_TIMEOUT_MS=4000
# STALE_AFTER_MS=30000
# RATE_LIMIT_PER_MIN=120
# TRUST_PROXY=false        # true behind a reverse proxy (docker-compose.yml sets it)

# docker-compose.yml: where the container's port 8080 is published on the host.
# Default 127.0.0.1:8080 (reverse proxy on the same host). Use 80 to take traffic on port 80.
# PUBLISH=127.0.0.1:8080
