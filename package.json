{
  "name": "alarmin",
  "private": true,
  "description": "Ukrainian air-raid alert widget for Garmin watches, with a TypeScript proxy",
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "codegen": "pnpm --filter @alarmin/shared codegen",
    "proxy:dev": "pnpm --filter @alarmin/proxy dev",
    "watch:build": "node scripts/watch.ts build",
    "watch:sim": "node scripts/watch.ts sim",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck && tsc -p scripts",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
